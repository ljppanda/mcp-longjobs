{
  "name": "mcp-longjobs",
  "version": "0.1.0",
  "description": "Durable, resumable operations for MCP servers: long-running tasks and chunked file transfers that survive timeouts, disconnects, and client restarts — on every client, no Tasks-extension support required.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-longjobs": "dist/examples/report-generator.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./tasks": {
      "types": "./dist/tasks/index.d.ts",
      "default": "./dist/tasks/index.js"
    },
    "./files": {
      "types": "./dist/files/index.d.ts",
      "default": "./dist/files/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "long-running",
    "tasks",
    "resumable",
    "chunked-transfer",
    "durable-execution",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ljppanda/mcp-longjobs.git"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "demo": "node scripts/e2e-demo.mjs",
    "example": "npm run build && node dist/examples/report-generator.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
